# EcoSort AI — backend environment variables
# Copy to .env and fill in real values before running in production.

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default, for local development):
DATABASE_URL=sqlite:///./ecosort.db
# PostgreSQL (for production on Render/Railway):
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/ecosort

# ── JWT Security ──────────────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION: generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440   # 24 hours
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slashes)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# ── IBM watsonx.ai (optional — EcoChat falls back to local KB without these) ──
IBM_WATSONX_APIKEY=
IBM_WATSONX_PROJECT_ID=
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── Rate Limiting ─────────────────────────────────────────────────────────────
AUTH_RATE_LIMIT_PER_MINUTE=10
