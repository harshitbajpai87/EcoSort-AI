# EcoSort AI — frontend environment variables
# Copy to .env.local for local development, or set in your deployment dashboard for production.

# ── Local development ─────────────────────────────────────────────────────────
# Leave VITE_API_BASE_URL UNSET (or commented out) during local development.
# Vite's dev server proxy (vite.config.ts) automatically forwards all /api/*
# requests to http://localhost:8000, so no cross-origin issues arise.
# VITE_API_BASE_URL=

# ── Production deployment ─────────────────────────────────────────────────────
# Set this to your deployed backend URL in your hosting provider's environment
# variables panel (e.g. Vercel → Settings → Environment Variables).
# Do NOT commit real production URLs to source control.
# VITE_API_BASE_URL=https://your-backend.onrender.com
